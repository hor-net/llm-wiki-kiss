# Root del wiki (default: ./wiki)
WIKI_ROOT=./wiki

# Token Bearer obbligatorio per MCP HTTPS e REST (generato da configure.sh)
WIKI_MCP_TOKEN=

# Interfaccia MCP HTTPS: disabilitata per default
WIKI_HTTPS_ENABLED=0
WIKI_HTTP_HOST=127.0.0.1
WIKI_HTTP_PORT=8766
WIKI_MCP_URL=
WIKI_TLS_CERT=
WIKI_TLS_KEY=

# Livello di log del server MCP (default: INFO)
WIKI_LOG_LEVEL=INFO
